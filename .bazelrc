common --enable_bzlmod
build --incompatible_strict_action_env
build --platforms=//build/bazel:macos_arm64
build --show_result=10
build --@rules_rust//rust/toolchain/channel:channel=nightly
test --test_output=errors

# V8 options (build settings of @v8//:BUILD.bazel) where Origine differs from upstream's defaults.
build --@v8//:v8_use_metagen=false
build --@v8//:v8_typed_array_max_size_in_heap=0

build:debug --compilation_mode=dbg
build:safe --compilation_mode=opt --@rules_zig//zig/settings:mode=release_safe
build:fast --compilation_mode=opt --@rules_zig//zig/settings:mode=release_fast
build:small --compilation_mode=opt --copt=-Os --@rules_zig//zig/settings:mode=release_small
