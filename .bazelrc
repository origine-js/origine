common --enable_bzlmod
build --incompatible_strict_action_env
build --platforms=//build/bazel:macos_arm64
build --show_result=10
build --@rules_rust//rust/toolchain/channel:channel=nightly
test --test_output=errors

# V8 options (build settings of @v8//:BUILD.bazel) where Origine differs from upstream's defaults.
build --@v8//:v8_use_metagen=false
build --@v8//:v8_typed_array_max_size_in_heap=0

# The build profile (build/bazel/build.py, `just build`) chooses the optimization of each part of
# the program through //build/bazel/settings:{critical,host}_optimization and rules_zig's mode; the
# defaults below are its `dev` profile. Performance-critical code (V8, C/C++, critical Zig modules
# and Rust crates) is release; V8 built with `-c opt` and without `-Os` is shared by every profile
# but release-small.
build --compilation_mode=opt
build --@rules_zig//zig/settings:mode=debug
