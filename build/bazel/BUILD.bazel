load("@rules_zig//zig:defs.bzl", "zig_static_library")

exports_files([
    "highway.patch",
    "icu.BUILD.bazel",
    "libcxx.BUILD.bazel",
    "llvm.BUILD.bazel",
    "lz4.BUILD.bazel",
    "mimalloc.BUILD.bazel",
    "nghttp2.BUILD.bazel",
    "rules_zig-sdk-inputs.patch",
    "temporal-headers.BUILD.bazel",
])

platform(
    name = "macos_arm64",
    constraint_values = ["@platforms//os:macos", "@platforms//cpu:aarch64"],
    visibility = ["//visibility:public"],
)

# Zig's compiler runtime alone (native), for programs whose Zig code is ThinLTO bitcode
# (zig_lto.bzl): bitcode does not carry it.
zig_static_library(
    name = "zig_compiler_rt",
    main = "empty.zig",
    compiler_runtime = "include",
    visibility = ["//visibility:public"],
)
