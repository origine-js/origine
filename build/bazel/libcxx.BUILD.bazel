load("@rules_cc//cc:defs.bzl", "cc_library")
load("@origine//build/bazel:cxx_runtime.bzl", "LIBCXXABI_DEFINES", "LIBCXX_DEFINES", "RUNTIME_COPTS")

package(default_visibility = ["//visibility:public"])

exports_files([
    "buildtools/third_party/libc++/__config_site",
    "libcxx/include/__config",
    "libcxxabi/include/cxxabi.h",
    "llvm-libc/shared/math.h",
])

filegroup(
    name = "headers",
    srcs = glob([
        "libcxx/include/**",
        "libcxxabi/include/**",
        "llvm-libc/**/*.h",
        "buildtools/third_party/libc++/*",
    ]),
)

cc_library(
    name = "libc++abi",
    srcs = glob(["libcxxabi/src/*.cpp"], exclude = ["libcxxabi/src/cxa_noexception.cpp", "libcxxabi/src/stdlib_new_delete.cpp"]),
    hdrs = [":headers"] + glob(["libcxxabi/src/**/*.h", "libcxxabi/src/**/*.def", "libcxx/src/include/**"]),
    copts = RUNTIME_COPTS,
    local_defines = LIBCXXABI_DEFINES,
    includes = ["libcxxabi/src", "libcxx/src"],
    linkstatic = True,
)

cc_library(
    name = "libc++",
    srcs = glob(["libcxx/src/*.cpp", "libcxx/src/filesystem/*.cpp"]),
    hdrs = [":headers"] + glob(["libcxx/src/**/*.h", "libcxx/src/**/*.ipp"]),
    copts = RUNTIME_COPTS,
    local_defines = LIBCXX_DEFINES,
    includes = ["libcxx/src", "libcxx/src/filesystem"],
    deps = [":libc++abi"],
    linkstatic = True,
)
