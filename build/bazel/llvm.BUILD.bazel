load("@rules_cc//cc:defs.bzl", "cc_toolchain")
load("@origine//build/bazel:cc_toolchain.bzl", "origine_cc_toolchain_config")

package(default_visibility = ["//visibility:public"])

exports_files(["bin/clang", "bin/clang++", "bin/ld64.lld", "bin/llvm-ar"])

filegroup(name = "builtin_headers", srcs = glob(["lib/clang/*/include/**"]))

filegroup(
    name = "files",
    srcs = glob(["bin/**", "lib/**"]),
)

filegroup(name = "empty")
filegroup(name = "toolchain_files", srcs = [":files", "@origine_macos_sdk//:files", "@libcxx//:headers"])
origine_cc_toolchain_config(name = "config", compiler = ":bin/clang", builtin_headers = ":builtin_headers")

cc_toolchain(
    name = "cc",
    toolchain_identifier = "origine-llvm-macos-arm64",
    toolchain_config = ":config",
    all_files = ":toolchain_files",
    ar_files = ":files",
    compiler_files = ":toolchain_files",
    linker_files = ":toolchain_files",
    dwp_files = ":empty",
    objcopy_files = ":files",
    strip_files = ":files",
    supports_param_files = 1,
)

toolchain(
    name = "macos_arm64_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
    toolchain = ":cc",
    exec_compatible_with = ["@platforms//os:macos", "@platforms//cpu:aarch64"],
    target_compatible_with = ["@platforms//os:macos", "@platforms//cpu:aarch64"],
)
