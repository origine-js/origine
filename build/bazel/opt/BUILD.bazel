load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "string_flag")
load("//build/bazel:opt.bzl", "C_LEVELS", "C_LIBRARIES", "RUST_CRATES", "RUST_LEVELS", "ZIG_MODES", "ZIG_MODULES")

package(default_visibility = ["//visibility:public"])

# One flag per optimizable module (see //build/bazel:opt.bzl). build/bazel/build.py sets all of them.
[
    (
        string_flag(name = module, build_setting_default = default, values = ZIG_MODES),
        [config_setting(name = module + "_" + mode, flag_values = {":" + module: mode}) for mode in ZIG_MODES],
    )
    for module, default in ZIG_MODULES.items()
]

[
    (
        string_flag(name = crate, build_setting_default = default, values = RUST_LEVELS),
        [config_setting(name = crate + "_" + level, flag_values = {":" + crate: level}) for level in RUST_LEVELS],
    )
    for crate, default in RUST_CRATES.items()
]

[
    (
        string_flag(name = "c_" + library, build_setting_default = default, values = C_LEVELS),
        [config_setting(name = "c_{}_{}".format(library, level), flag_values = {":c_" + library: level}) for level in C_LEVELS],
    )
    for library, default in C_LIBRARIES.items()
]

# Whether the program's Zig code joins the final ThinLTO link as bitcode (//build/bazel:zig_lto.bzl).
# build/bazel/build.py sets it with the rest of a profile's LTO flags.
bool_flag(name = "lto", build_setting_default = False)

config_setting(name = "lto_on", flag_values = {":lto": "true"})
