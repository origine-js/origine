"""`zig_options`: a generated Zig source of `pub const` declarations, as `std.Build.Step.Options`.

    zig_options(
        name = "build_options_zig",
        constants = {"has_snapshot": "bool = true"},
        settings = {"//build/bazel/settings:snapshot_seed": "snapshot_seed: u32"},
    )

`constants` maps a name to `<type> = <value>`; `settings` maps a build setting (an int, bool or
string flag) to `<name>: <type>`, its value read at analysis. Wrap the output in a `zig_library`.
"""

load("@bazel_skylib//rules:common_settings.bzl", "BuildSettingInfo")

def _zig_literal(value):
    if type(value) == "bool":
        return "true" if value else "false"
    if type(value) == "string":
        return json.encode(value)
    return str(value)

def _zig_options_impl(ctx):
    lines = ["// Generated by //build/bazel:zig_options.bzl for {}; do not edit.".format(ctx.label)]
    for name, typed in sorted(ctx.attr.constants.items()):
        lines.append("pub const {}: {};".format(name, typed))
    for setting, declaration in ctx.attr.settings.items():
        lines.append("pub const {} = {};".format(declaration, _zig_literal(setting[BuildSettingInfo].value)))
    out = ctx.actions.declare_file(ctx.label.name + ".zig")
    ctx.actions.write(out, "\n".join(lines) + "\n")
    return [DefaultInfo(files = depset([out]))]

zig_options = rule(
    implementation = _zig_options_impl,
    attrs = {
        "constants": attr.string_dict(),
        "settings": attr.label_keyed_string_dict(providers = [BuildSettingInfo]),
    },
)
