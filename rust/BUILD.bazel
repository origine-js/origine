load("@rules_rust//rust:defs.bzl", "rust_static_library")
load("//build/bazel:features.bzl", "if_feature")
load("//build/bazel:opt.bzl", "rust_opt")

exports_files(["Cargo.toml", "Cargo.lock", "rust-toolchain.toml"])

# liborigine_native.a, as Cargo builds it: every Rust crate of the program in one archive with one
# Rust std, Temporal's (temporal_capi, through rusty_v8) included, and the allocator shim rustc
# writes for a staticlib. No Rust target declares a native library (those are linked by the
# program, src/BUILD.bazel, or by a test), so nothing native is bundled in.
rust_static_library(
    name = "origine_native",
    srcs = ["src/lib.rs"],
    crate_root = "src/lib.rs",
    rustc_flags = rust_opt("origine_native"),
    # Cargo features from //build/bazel/settings (http/tls/dns/quic only forward to origine_api).
    crate_features = if_feature("typescript", ["typescript"]) + if_feature("http", ["http"]) +
                     if_feature("tls", ["tls"]) + if_feature("dns", ["dns"]) + if_feature("quic", ["quic"]),
    deps = [
        "//rust/crates/origine_alloc",
        "//rust/crates/origine_api",
        "//rust/crates/origine_repl",
    ] + if_feature("typescript", ["//rust/crates/origine_oxc"]),
    visibility = ["//visibility:public"],
)

test_suite(
    name = "core-tests",
    tests = [
        "//rust/crates/origine_alloc:alloc_test",
        "//rust/crates/origine_api_core:core_test",
        "//rust/crates/origine_api_fs:fs_test",
        "//rust/crates/origine_io:io_test",
    ],
)
