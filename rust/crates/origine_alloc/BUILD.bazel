load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build/bazel:opt.bzl", "rust_opt")

rust_library(
    name = "origine_alloc",
    rustc_flags = rust_opt("origine_alloc"),
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    visibility = ["//visibility:public"],
)

rust_test(name = "alloc_test", crate = ":origine_alloc", link_deps = ["@origine_mimalloc//:mimalloc"])
