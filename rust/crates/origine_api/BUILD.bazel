load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build/bazel:features.bzl", "if_feature")
load("//build/bazel:rust_dependencies.bzl", "registry_deps")
load("//build/bazel:opt.bzl", "rust_opt")

# No rust_test: the crate links V8 (its pure-Rust logic is tested in origine_api_core).
rust_library(
    name = "origine_api",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    rustc_flags = rust_opt("origine_api"),
    # Cargo features `tls`, `http`, `dns`, from //build/bazel/settings.
    crate_features = if_feature("tls", ["tls"]) + if_feature("http", ["http"]) + if_feature("dns", ["dns"]),
    deps = [
        "//lib/v8_zig/rusty_v8:v8",
        "//rust/crates/origine_api_core",
        "//rust/crates/origine_api_fs",
        "//rust/crates/origine_io",
    ] + if_feature("tls", ["//rust/crates/origine_tls"]) +
           if_feature("http", ["//rust/crates/origine_h2"]) +
           if_feature("dns", ["//rust/crates/origine_dns"]) +
           if_feature("networking", ["//rust/crates/origine_transport"]) + registry_deps("origine_api"),
    proc_macro_deps = ["//rust/crates/origine_api_macros"],
    visibility = ["//visibility:public"],
)
