load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build/bazel:rust_dependencies.bzl", "registry_deps")

rust_library(
    name = "origine_h2",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    deps = ["//rust/crates/origine_transport"],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "h2_test",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    deps = ["//rust/crates/origine_transport:testing", "//rust/crates/origine_tls:testing"] + registry_deps("origine_h2", kind = "dev"),
    link_deps = ["@origine_nghttp2//:nghttp2", "//lib/aws-lc:aws_lc_crypto"],
)
