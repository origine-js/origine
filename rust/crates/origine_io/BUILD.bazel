load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build/bazel:opt.bzl", "rust_opt")

rust_library(
    name = "origine_io",
    rustc_flags = rust_opt("origine_io"),
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    visibility = ["//visibility:public"],
)

rust_test(name = "io_test", crate = ":origine_io", link_deps = ["//src:io_native"])
