load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build/bazel:features.bzl", "if_feature")
load("//build/bazel:rust_dependencies.bzl", "registry_deps")
load("//build/bazel:opt.bzl", "rust_opt")

rust_library(
    name = "origine_repl",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    rustc_flags = rust_opt("origine_repl"),
    crate_features = if_feature("typescript", ["typescript"]),
    deps = if_feature("typescript", ["//rust/crates/origine_oxc"]) + registry_deps("origine_repl"),
    visibility = ["//visibility:public"],
)

rust_test(name = "repl_test", crate = ":origine_repl")
