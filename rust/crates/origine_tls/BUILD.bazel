load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//build/bazel:rust_dependencies.bzl", "registry_deps")
load("//build/bazel:opt.bzl", "rust_opt")

rust_library(
    name = "origine_tls",
    rustc_flags = rust_opt("origine_tls"),
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    deps = ["//rust/crates/origine_transport"] + registry_deps("origine_tls"),
    visibility = ["//visibility:public"],
)

rust_library(
    name = "testing",
    crate_name = "origine_tls",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    deps = ["//rust/crates/origine_transport:testing"] + registry_deps("origine_tls"),
    testonly = True,
    visibility = ["//rust/crates/origine_h2:__pkg__"],
)

rust_test(
    name = "tls_test",
    crate = ":testing",
    deps = registry_deps("origine_tls", kind = "dev"),
    link_deps = ["//lib/aws-lc:aws_lc_crypto"],
)
