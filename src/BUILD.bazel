load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_zig//zig:defs.bzl", "zig_configure", "zig_library", "zig_static_library", "zig_test")
load("//build/bazel:features.bzl", "FEATURES", "if_feature")
load("//build/bazel:opt.bzl", "zig_opt")
load("//build/bazel:zig_lto.bzl", "zig_lto_library")
load("//build/bazel:zig_options.bzl", "zig_options")

zig_library(
    name = "safe",
    main = "safe.zig",
    import_name = "@safe",
    zigopts = zig_opt("safe"),
)

zig_library(
    name = "io",
    main = "io/io.zig",
    srcs = glob(["io/**/*.zig"]),
    extra_srcs = glob(["io/include/**"]),
    deps = [":safe"],
    import_name = "@io",
    zigopts = zig_opt("io"),
    visibility = ["//visibility:public"],
)

# Tests compile their module as the test root: rules_zig's mode, not the critical `-O` of the module.
zig_test(
    name = "io_test",
    main = "io/io.zig",
    srcs = glob(["io/**/*.zig"]),
    extra_srcs = glob(["io/include/**"]),
    deps = [":safe"],
    zigopts = ["-lc"],
)

zig_lto_library(
    name = "io_native_unconfigured",
    module = "io_native",
    main = "io/lib.zig",
    deps = [":io"],
    zigopts = ["-lc", "-fllvm"],
)

[
    zig_configure(
        name = "io_native_" + mode,
        actual = ":io_native_unconfigured",
        mode = {"debug": "debug", "safe": "release_safe", "fast": "release_fast", "small": "release_small"}[mode],
    )
    for mode in ["debug", "safe", "fast", "small"]
]

# The event loop's mode (//build/bazel/opt:io_native).
alias(
    name = "io_native",
    actual = select({
        "//build/bazel/opt:io_native_" + mode: ":io_native_" + mode
        for mode in ["debug", "safe", "fast", "small"]
    }),
    visibility = ["//visibility:public"],
)

zig_test(
    name = "safe_test",
    main = "safe.zig",
)

# The programs: a Zig host (origine, origine-snapshot) linked by the C++ toolchain (V8's Clang and
# ld64.lld) with the Rust staticlib (//rust:origine_native), V8 and the native libraries.


# `origine_config`: the compiled-in features (//build/bazel/settings), as build.zig's `config`.
zig_options(
    name = "origine_config_zig",
    settings = {"//build/bazel/settings:" + feature: feature + ": bool" for feature in FEATURES} | {
        "//build/bazel/settings:user_snapshot_compression": "user_snapshot_compressed: bool",
        "//build/bazel/settings:user_codecache_compression": "user_codecache_compressed: bool",
    },
    # A feature's `requires` must be on with it (one requirement each).
    implies = {feature: info["requires"][0] for feature, info in FEATURES.items() if info["requires"]},
)

zig_library(
    name = "origine_config",
    main = ":origine_config_zig",
    import_name = "origine_config",
)

# `build_options`: the engine snapshot's embedding and seed.
zig_options(
    name = "build_options_zig",
    constants = {
        "has_snapshot": "bool = true",
        "v8_sandbox": "bool = true",
    } | select({
        # build.zig: `optimize == .debug`.
        "@rules_zig//zig/config/mode:debug": {"snapshot_seeded": "bool = true"},
        "//conditions:default": {"snapshot_seeded": "bool = false"},
    }),
    settings = {
        "//build/bazel/settings:snapshot_seed": "snapshot_seed: u32",
        "//build/bazel/settings:engine_snapshot_compression": "engine_snapshot_compressed: bool",
    },
)

zig_library(
    name = "build_options",
    main = ":build_options_zig",
    import_name = "build_options",
)

zig_library(
    name = "engine",
    main = "engine.zig",
    import_name = "@engine",
    zigopts = zig_opt("engine"),
    deps = ["//lib/v8_zig:v8", "//lib/v8_zig:diagnostics"],
)

zig_library(
    name = "managed",
    main = "managed.zig",
    srcs = glob(["managed/**/*.zig", "api/**/*.zig", "repl/**/*.zig", "fs_light/**/*.zig", "api.zig", "repl.zig"]),
    extra_srcs = glob(["js/**/*.js", "repl/**/*.js"]),
    import_name = "@managed",
    zigopts = zig_opt("managed"),
    deps = [
        ":io",
        ":origine_config",
        "//lib/lz4",
        "//lib/v8_zig:diagnostics",
        "//lib/v8_zig:util",
        "//lib/v8_zig:v8",
    ],
)

_HOST_DEPS = [
    ":build_options",
    ":engine",
    ":io",
    ":managed",
    "//lib/lz4",
    "//lib/v8_zig:diagnostics",
    "//lib/v8_zig:util",
    "//lib/v8_zig:v8",
]

# What a program that runs the engine links besides its Zig root, each once: the Rust staticlib
# and the native libraries it and the Zig host call.
_NATIVE_DEPS = [
    ":io_native",
    "//rust:origine_native",
    "@origine_mimalloc//:mimalloc",
    "@v8//:origine_binding_icu",
] + select({
    "//build/bazel/settings:icu_compression_on": ["//lib/v8_zig/binding:icu_compressed"],
    "//conditions:default": ["//lib/v8_zig/binding:icu_raw"],
}) + if_feature("tls", ["//lib/aws-lc:aws_lc_crypto"]) + if_feature("http", ["@origine_nghttp2//:nghttp2"])



zig_lto_library(
    name = "snapshot_tool_main",
    module = "snapshot_tool_main",
    main = "snapshot_tool.zig",
    deps = _HOST_DEPS,
    compiler_runtime = "include",
    # libc: std.start exports the C `main` the program starts from.
    zigopts = ["-lc"] + zig_opt("snapshot_tool_main"),
)

cc_binary(
    name = "origine-snapshot",
    deps = [":snapshot_tool_main"] + _NATIVE_DEPS,
)

# The tool is a src, not a `tools` entry: it must be the target configuration's build (the same
# V8 as the program the blob is embedded in), not a second, exec-configured V8.
genrule(
    name = "engine_snapshot",
    srcs = [":origine-snapshot"],
    outs = ["engine.snapshot"],
    # Compressed: the tool LZ4-packs the blob (src/snapshot_tool.zig's `lz4` argument).
    cmd = select({
        "//build/bazel/settings:engine_snapshot_compression_on": "$(execpath :origine-snapshot) $@ lz4",
        "//conditions:default": "$(execpath :origine-snapshot) $@",
    }),
)

_PROVIDER = """cat > $@ <<'EOF'
const bytes = @embedFile("engine.snapshot");
const blob: [bytes.len]u8 align(16) = bytes.*;
pub export const origine_snapshot_present: bool = true;
pub export const origine_snapshot_blob: [*]const u8 = &blob;
pub export const origine_snapshot_len: usize = blob.len;
pub export const origine_snapshot_compressed: bool = {};
EOF"""

# The blob as a link object exporting `origine_snapshot_*` (main.zig declares them), so the
# blob is not an input of the host's own compilation.
genrule(
    name = "snapshot_provider_zig",
    outs = ["snapshot_provider.zig"],
    cmd = select({
        "//build/bazel/settings:engine_snapshot_compression_on": _PROVIDER.format("true"),
        "//conditions:default": _PROVIDER.format("false"),
    }),
)

zig_static_library(
    name = "snapshot_provider",
    main = ":snapshot_provider_zig",
    extra_srcs = [":engine_snapshot"],
)

zig_lto_library(
    name = "origine_main",
    module = "origine_main",
    main = "main.zig",
    deps = _HOST_DEPS,
    compiler_runtime = "include",
    # libc: std.start exports the C `main` the program starts from.
    zigopts = ["-lc"] + zig_opt("origine_main"),
)

cc_binary(
    name = "origine",
    deps = [":origine_main", ":snapshot_provider"] + _NATIVE_DEPS,
    visibility = ["//visibility:public"],
)
